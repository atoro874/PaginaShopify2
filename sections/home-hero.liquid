{%- style -%}
  #HomeHero-{{ section.id }} {
    position: relative;
    display: grid;
    min-height: 56rem;
    overflow: hidden;
    isolation: isolate;
    align-items: center;
  }

  #HomeHero-{{ section.id }} .home-hero__media,
  #HomeHero-{{ section.id }} .home-hero__overlay {
    position: absolute;
    z-index: -1;
    inset: 0;
  }

  #HomeHero-{{ section.id }} .home-hero__media img,
  #HomeHero-{{ section.id }} .home-hero__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #HomeHero-{{ section.id }} .home-hero__overlay {
    background: #000;
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  #HomeHero-{{ section.id }} .home-hero__content {
    width: min(58rem, calc(100% - 6rem));
    margin: 5rem max(calc((100vw - var(--page-width)) / 2), 3rem);
    padding: clamp(2.4rem, 5vw, 5.2rem);
    color: {{ section.settings.text_color }};
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: 2rem;
    box-shadow: 0 1.2rem 4rem rgba(0, 0, 0, 0.14);
    -webkit-backdrop-filter: blur(1.4rem);
    backdrop-filter: blur(1.4rem);
  }

  #HomeHero-{{ section.id }} .home-hero__heading {
    margin: 0;
    color: inherit;
  }

  #HomeHero-{{ section.id }} .home-hero__text {
    margin-top: 1.6rem;
    color: inherit;
  }

  #HomeHero-{{ section.id }} .home-hero__text:empty {
    display: none;
  }

  #HomeHero-{{ section.id }} .home-hero__button {
    margin-top: 2.4rem;
  }

  @media screen and (max-width: 749px) {
    #HomeHero-{{ section.id }} {
      min-height: 48rem;
    }

    #HomeHero-{{ section.id }} .home-hero__content {
      width: calc(100% - 3.2rem);
      margin: 2.4rem 1.6rem;
      padding: 2.4rem;
      border-radius: 1.6rem;
    }
  }
{%- endstyle -%}

<section id="HomeHero-{{ section.id }}" class="home-hero" aria-labelledby="HomeHeroHeading-{{ section.id }}">
  <div class="home-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          sizes: '100vw',
          fetchpriority: 'high'
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'home-hero__placeholder placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="home-hero__overlay" aria-hidden="true"></div>
  <div class="home-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 id="HomeHeroHeading-{{ section.id }}" class="home-hero__heading h0">
        {{ section.settings.heading | escape }}
      </h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="home-hero__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button home-hero__button" href="{{ routes.all_products_collection_url }}">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner principal de Home",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de fondo"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "%",
      "label": "Oscurecimiento de la imagen",
      "default": 30
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Descubre nuestros productos"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Encuentra la opción ideal para ti.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#141414"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Comprar ya"
    }
  ],
  "presets": [
    {
      "name": "Banner principal de Home"
    }
  ]
}
{% endschema %}
